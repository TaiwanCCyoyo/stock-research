{
    "version": 1,
    "test_roots": [
        "tests",
        "scripts/tests",
        ".codex/hooks/tests",
        ".claude/hooks/tests"
    ],
    "full_paths": [
        ".github/*",
        "pyproject.toml",
        "uv.lock",
        "*requirements*",
        "*lock*",
        "*package.json",
        "*conftest.py",
        "research_core/__init__.py",
        "research_api/__init__.py",
        "research_api/main.py",
        "research_core/price*",
        "research_core/producer_data.py",
        "research_core/derived_*",
        "research_core/*ledger*",
        "research_core/cache*",
        "research_core/bounded_parquet.py",
        "research_core/jobs.py",
        "research_core/windows_process_job.py",
        "StockProject/*",
        "docker-compose.yml",
        "Dockerfile*",
        "stock-data-downloader",
        ".gitmodules",
        "research_core/artifact_*",
        "research_core/evidence.py"
    ],
    "full_path_exceptions": [".github/workflows/ci.yml"],
    "domains": {
        "ci": {
            "paths": [
                ".github/workflows/ci.yml",
                "scripts/ci_scope.py",
                "scripts/ci_test_domains.json"
            ],
            "tests": [
                "scripts/tests/test_ci_scope.py",
                "scripts/tests/test_mypy_scopes.py",
                "scripts/tests/test_file_hygiene.py"
            ]
        },
        "web": {
            "paths": ["research_web/*"],
            "tests": [],
            "frontend": true
        },
        "opportunity": {
            "paths": [
                "research_api/history.py",
                "research_api/saved_research_studio.py",
                "research_api/private_artifacts.py",
                "research_core/opportunity_*",
                "research_core/saved_research_studio.py",
                "research_core/strategy_map_capture.py",
                "scripts/*opportunity*",
                "scripts/*saved_research*",
                "scripts/export_history_title_origins.py",
                "research_web/src/api/*",
                "research_web/scripts/export-*",
                "research_web/scripts/*classification*",
                "research_web/src/domain/opportunities/*",
                "research_web/src/features/opportunities/*",
                "research_web/src/features/full-history/*",
                "research_web/src/features/research-history/*",
                "research_web/src/features/strategies/*",
                "research_web/public/data/*",
                "research_web/fixtures/*"
            ],
            "tests": [
                "scripts/tests/test_*opportunity*.py",
                "scripts/tests/test_*saved*catalog*.py",
                "scripts/tests/test_*saved_research*.py",
                "scripts/tests/test_*private_artifacts*.py",
                "scripts/tests/test_history_title_origins_export.py",
                "scripts/tests/test_studio_review_coverage.py",
                "scripts/tests/test_strategy_map_capture.py",
                "scripts/tests/test_start_research_web.py",
                "tests/test_*opportunity*.py",
                "tests/test_research_api*.py",
                "tests/test_dashboard*.py",
                "tests/test_static_report_export.py",
                "scripts/tests/test_optional_research_dependencies.py"
            ],
            "frontend": true
        },
        "hhhl": {
            "paths": [
                "research_core/hhhl_*",
                "research_core/patterns/hhhl/*",
                "scripts/*hhhl*",
                "tasks/20261009-hhhl-pattern-probability/*",
                "tasks/20261010-hhhl-v4-probability/*"
            ],
            "tests": [
                "scripts/tests/test_*hhhl*.py",
                "scripts/tests/test_pattern_sources.py",
                "scripts/tests/test_cache_execution.py"
            ],
            "consumers": ["opportunity"]
        },
        "atlas": {
            "paths": [
                "research_core/feature_atlas_*",
                "scripts/*feature*atlas*",
                "scripts/export_market_atlas.py",
                "tasks/20261004-feature-discrimination-atlas/*"
            ],
            "tests": [
                "scripts/tests/test_*feature*atlas*.py",
                "scripts/tests/test_export_market_atlas.py"
            ],
            "consumers": ["opportunity", "method_environment", "sector", "hhhl"]
        },
        "sector": {
            "paths": [
                "research_core/sector_*",
                "research_core/industry_role_comparison.py",
                "research_core/wave_growth.py",
                "scripts/*sector*",
                "scripts/*industry_role*",
                "scripts/*wave_growth*",
                "tasks/20261005-industry-role-comparison/*",
                "tasks/20261005-sector-wave-scan/*"
            ],
            "tests": [
                "scripts/tests/test_sector*.py",
                "scripts/tests/test_industry_role*.py",
                "scripts/tests/test_score_wave_growth.py",
                "tests/test_wave_growth.py",
                "tests/test_symbol_classification.py"
            ],
            "consumers": ["opportunity", "method_environment"]
        },
        "market_context": {
            "paths": [
                "research_core/market_context*",
                "scripts/*market_context*",
                "tasks/20261005-market-context-handoff/*"
            ],
            "tests": ["scripts/tests/test_market_context*.py"],
            "consumers": ["opportunity", "method_environment", "sector"]
        },
        "method_environment": {
            "paths": [
                "research_core/method_environment*",
                "scripts/*method_environment*",
                "tasks/20261005-method-environment-interactions/*"
            ],
            "tests": ["scripts/tests/test_method_environment*.py"],
            "consumers": ["opportunity", "sector"]
        },
        "hooks": {
            "paths": [
                ".codex/*",
                ".claude/*",
                ".agents/*",
                ".githooks/*",
                "AGENTS.md",
                "CLAUDE.md",
                ".pre-commit-config.yaml",
                ".secrets.baseline",
                ".gitattributes",
                "scripts/file_hygiene.py",
                "scripts/worktree_inventory.py",
                "scripts/seed_worktree_inputs.py",
                "scripts/check_mypy_scopes.py",
                "scripts/check_added_large_files.py",
                "scripts/audit_public_readiness.py"
