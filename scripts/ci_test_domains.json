            "tests": [
                ".codex/hooks/tests/test_*.py",
                ".claude/hooks/tests/test_*.py",
                "scripts/tests/test_*hook*.py",
                "scripts/tests/test_agent_instruction_contract.py",
                "scripts/tests/test_file_hygiene.py",
                "scripts/tests/test_mypy_scopes.py",
                "scripts/tests/test_added_file_size_limits.py",
                "scripts/tests/test_secret_checksum_baseline.py",
                "scripts/tests/test_worktree_inventory.py",
                "scripts/tests/test_seed_worktree_inputs.py",
                "scripts/tests/test_audit_public_readiness.py",
                "scripts/tests/test_ci_scope.py",
                "tests/test_post_checkout_hook.py"
            ]
        },
        "prose": {
            "paths": [
                "docs/*.md",
                "docs/*.rst",
                "README.md",
                "CONTRIBUTING.md",
                "CHANGELOG.md",
                "LICENSE"
            ],
            "tests": [
                "scripts/tests/test_agent_instruction_contract.py",
                "scripts/tests/test_file_hygiene.py",
                "scripts/tests/test_research_chronology.py",
                "tests/test_experiment_spec.py",
                "tests/test_dashboard_task_index.py"
            ]
        }
