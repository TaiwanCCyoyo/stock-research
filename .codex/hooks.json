{
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "apply_patch|Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "uv run --no-sync python \"$(git rev-parse --show-toplevel)/.codex/hooks/codex_post_tool_use_hygiene.py\"",
                        "timeout": 30,
                        "statusMessage": "Checking Python diagnostics"
                    }
                ]
            }
        ]
    }
}
